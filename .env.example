# GroundedRAG configuration. Copy to .env and fill in the three required values:
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real secrets. See README.md for the full
# configuration reference.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Gemini API key (https://aistudio.google.com/apikey). Use a billing-enabled
# (paid) project for enterprise documents: see TDD section 9.
GOOGLE_API_KEY=

# Signing key for login tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Postgres password. Keep it URL-safe (letters and digits): it is embedded in
# DATABASE_URL by docker-compose.yml. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------

POSTGRES_USER=groundedrag
POSTGRES_DB=groundedrag

# Host port for the web UI (the only published port).
HTTP_PORT=8081
# Address the port is published on. 127.0.0.1 (the default) means this machine only. Set 0.0.0.0
# to share the app on your network, but note there is no TLS, and the first account to sign up
# becomes the administrator: create yours first, then close signup (SIGNUP_ENABLED=false below).
BIND_ADDR=127.0.0.1

# Memory ceilings for the containers (Docker kills a service that exceeds its ceiling instead of
# letting it starve the host). Parsing a very large PDF is the heaviest thing the backend does.
# BACKEND_MEM_LIMIT=3g
# CHROMA_MEM_LIMIT=2g
# POSTGRES_MEM_LIMIT=1g
# FRONTEND_MEM_LIMIT=256m

# docker-compose.yml sets DATABASE_URL, CHROMA_HOST, CHROMA_PORT and UPLOAD_DIR
# for the backend container. Set them yourself only when running the backend
# outside Docker:
# DATABASE_URL=postgresql+psycopg://groundedrag:<password>@localhost:5432/groundedrag
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# UPLOAD_DIR=./data/uploads

# Connections the backend may hold open to Postgres: DB_POOL_SIZE kept ready plus DB_MAX_OVERFLOW
# extra under load, and how long a request waits for one before failing. Postgres allows 100 by
# default, so keep the sum well below that.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT_SECONDS=30

# Base name of the Chroma collection. The model and dimension are appended
# automatically, e.g. chunks__gemini-embedding-001__768.
CHROMA_COLLECTION=chunks

# ---------------------------------------------------------------------------
# Models (changing any of these requires re-running eval/run_eval.py and
# recalibrating RELEVANCE_THRESHOLD: see CLAUDE.md rule 17)
# ---------------------------------------------------------------------------

EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=4
# Retries per batch on rate limits (429) and transient errors, with exponential backoff
# that honours the server's "retry in N seconds" hint. NOTE: free-tier Gemini keys allow
# only about 100 embedding requests per minute (every text counts), so indexing runs at
# roughly 100 chunks per minute and large documents take a long time (or hit the daily
# quota). Use a billing-enabled key for real workloads (TDD section 9).
EMBEDDING_MAX_RETRIES=6
# Document texts embedded per minute. A large upload is spread out so it cannot use up the key's
# per-minute quota and leave chat questions waiting (questions are never held back by this).
# 90 suits a free-tier key; with a billing-enabled key raise it, or set 0 to turn it off.
EMBEDDING_TEXTS_PER_MINUTE=90

# gemini-2.5-flash is closed to new API keys (404 "no longer available to new users"), so the
# default is gemini-3.8-flash. List what your key can use: client.models.list().
LLM_MODEL=gemini-3.8-flash
# Model used to rewrite follow-up questions. Empty means "same as LLM_MODEL".
REWRITE_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
LLM_THINKING_BUDGET=0
# Seconds before a model call is abandoned.
LLM_TIMEOUT_SECONDS=60
# A user is waiting on a chat answer: rate limits (429) are retried this many times, waiting
# at most this many seconds once (the server's retry hint is honoured). Beyond that the chat
# shows "Rate limit reached, please try again in a minute". Free-tier keys have per-minute
# AND per-day limits (README, Troubleshooting).
INTERACTIVE_MAX_RETRIES=2
INTERACTIVE_MAX_WAIT_SECONDS=30

# ---------------------------------------------------------------------------
# Retrieval and grounding
# ---------------------------------------------------------------------------

RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_K=5
RRF_K=60
# Best dense cosine similarity a question needs before the LLM is called. Calibrated with
# eval/questions.jsonl on gemini-embedding-001 at 768 dims (TDD 6.3): off-topic questions score
# at most about 0.55, answerable ones at least about 0.64. Re-calibrate after changing the
# embedding model.
RELEVANCE_THRESHOLD=0.60
# An exact identifier in the best keyword hit (ERR_404_NET) lets a question through even below the
# threshold, but not by more than this margin: a question nowhere near the documents is refused
# whatever numbers it contains. 0 turns the override off.
LEXICAL_OVERRIDE_MARGIN=0.15
# Must stay false: reranking is not implemented, and true is rejected at startup.
RERANK_ENABLED=false

# ---------------------------------------------------------------------------
# Analysis: summaries, extraction, comparison, conflicts (TDD 16)
# ---------------------------------------------------------------------------

# Output budget of one analysis call. A chapter summary or a table of fields is much longer than a
# chat answer.
ANALYSIS_MAX_TOKENS=4096
# A busy or briefly unavailable model (429, 503) is retried this many times before a summary,
# extraction or comparison gives up (waits of 2, 4, 8... seconds, each at most
# INTERACTIVE_MAX_WAIT_SECONDS; the screen says "the AI service is busy"). Chat answers use
# INTERACTIVE_MAX_RETRIES, and so does the extra conflict check, which must never hold up an answer.
ANALYSIS_MAX_RETRIES=4
# A document with more text than this is read in batches and the notes are combined (map-reduce),
# which costs one extra model call per batch. Most documents fit in one call.
ANALYSIS_MAX_SOURCE_CHARS=120000
# Write an executive summary of every document right after it is indexed (one model call per
# upload; it is saved and shown in the Library and the Analyze page). false: only on request.
AUTO_EXECUTIVE_SUMMARY=true
# After an answer that cites two or more documents, one extra model call checks whether they
# contradict each other and shows both claims. false turns the check off in Chat and Compare.
CONFLICT_DETECTION=true
# Documents in one comparison (2 to 8) and fields in one extraction (1 to 50).
COMPARE_MAX_DOCUMENTS=4
EXTRACTION_MAX_FIELDS=20

# ---------------------------------------------------------------------------
# Suggestions (TDD 18)
# ---------------------------------------------------------------------------

# After every answered chat question, one extra model call (run alongside the conflict check)
# proposes follow-up, sub- and related questions, each answerable from a retrieved passage.
FOLLOWUP_SUGGESTIONS=true
# Questions written for a document the first time it is selected in Chat (one call, then saved).
SUGGESTIONS_PER_DOCUMENT=6
# A question one person asked is suggested to others only once this many different users asked
# it (and got a cleanly cited answer). At least 2.
POPULAR_MIN_USERS=2

# ---------------------------------------------------------------------------
# Semantic answer cache
# ---------------------------------------------------------------------------

# A clean, cited answer is reused when the same question (or a near-identical one) is asked again
# under the same access level, filters and document selection: no search and no model call.
# Kept in memory, dropped when a document in scope is uploaded or deleted, and empty after a restart.
SEMANTIC_CACHE=true
# How alike two questions must be (cosine similarity, 0.85 to 1). Do not go below 0.93 without
# running the evaluation: "sick leave" and "annual leave" questions can score 0.9.
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_MAX_ENTRIES=1000

# ---------------------------------------------------------------------------
# Evaluation dashboard (TDD 17)
# ---------------------------------------------------------------------------

# Measurements of chat turns and analysis runs (with the question text) are deleted after this.
METRICS_RETENTION_DAYS=90
# Your model's price in US dollars per million tokens, for the cost estimate. 0 shows tokens only.
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------

# Chunk size plus 1.5x the overlap plus one separator character must stay at or below 1500
# characters, so no chunk can reach the embedding model's 2,048-token limit and be silently
# truncated.
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=100
# Largest single file, in MB. (nginx accepts up to 256 MB per upload request in total.)
MAX_UPLOAD_MB=50
# Files accepted in one upload request.
MAX_FILES_PER_REQUEST=20
# A document whose extracted text is longer than this fails with a clear message instead of
# tying up the single ingestion worker.
MAX_DOCUMENT_CHARS=5000000
# Documents indexed at the same time. 1 keeps embedding API usage predictable.
INGESTION_WORKERS=1

# ---------------------------------------------------------------------------
# Auth and logging
# ---------------------------------------------------------------------------

# Token lifetime in minutes (1 to 10080).
JWT_EXPIRE_MINUTES=60
# false closes self-service signup once the first account exists (the first account can always
# be created, so a fresh install is never locked out). Close it after creating your accounts.
SIGNUP_ENABLED=true
# bcrypt work factor for password hashing (4-15). 12 costs roughly 250 ms per hash.
BCRYPT_ROUNDS=12
LOG_LEVEL=INFO
